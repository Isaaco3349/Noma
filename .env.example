# Copy to .env.local in frontend/ (or root) — placeholders only, no real secrets.

# Monad testnet RPC (public endpoint from Monad docs)
# Default in code if unset: https://testnet-rpc.monad.xyz (Monad docs)
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=

# Optional: alternate RPC if primary is rate-limited
# NEXT_PUBLIC_MONAD_TESTNET_RPC_URL_FALLBACK=

# Paystack (server-only — never NEXT_PUBLIC_*)
# Test: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=
# Transfers: auto (default) = try Paystack, demo NGN if sandbox balance insufficient
# NOMA_PAYSTACK_TRANSFER_MODE=auto|live|demo
# Optional demo USD→NGN rate for quotes (not live FX)
NOMA_DEMO_USD_NGN_RATE=1550

# Day 6 — Monad testnet contracts (from `forge script script/DeployNoma.s.sol --broadcast`)
# Agora AUSD on Monad testnet (TODO(verify) on MonadScan): use instead of MockERC20 for Agora track
# NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0xa9012a055bd4e0eDfF8Ce09f960291C09D5322dC
# NEXT_PUBLIC_SETTLEMENT_TOKEN_DECIMALS=6
NEXT_PUBLIC_NOMA_REGISTRY_ADDRESS=
NEXT_PUBLIC_NOMA_SETTLEMENT_ADAPTER_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=
NEXT_PUBLIC_PAYOUT_SINK_ADDRESS=
NEXT_PUBLIC_SETTLEMENT_TOKEN_DECIMALS=18

# Agora Stablecoin API — optional; public /v0/metrics needs no key
# Create key: Agora dashboard → API keys → https://docs.agora.finance/api
AGORA_API_KEY=
